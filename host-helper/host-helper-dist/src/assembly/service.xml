<assembly>
    <id>service</id>
    <formats><format>tar.gz</format></formats>
    <includeBaseDirectory>true</includeBaseDirectory>
    <baseDirectory>${project.version}</baseDirectory>
    <dependencySets>
        <dependencySet>
            <outputDirectory>lib</outputDirectory>
            <useProjectArtifact>false</useProjectArtifact>
            <unpack>false</unpack>
            <scope>runtime</scope>
        </dependencySet>
    </dependencySets>
    <files>
        <file>
            <source>${project.build.directory}/${project.build.finalName}-service-launcher.jar</source>
            <outputDirectory>/</outputDirectory>
            <destName>app.jar</destName>
        </file>
        <file>
            <source>${project.build.directory}/zora-bin/bin/lifecycle.sh</source>
            <outputDirectory>bin</outputDirectory>
            <fileMode>0755</fileMode>
        </file>
        <file>
            <source>${project.build.directory}/zora-bin/bin/start.sh</source>
            <outputDirectory>bin</outputDirectory>
            <fileMode>0755</fileMode>
        </file>
        <file>
            <source>${project.build.directory}/zora-bin/bin/stop.sh</source>
            <outputDirectory>bin</outputDirectory>
            <fileMode>0755</fileMode>
        </file>
        <file>
            <source>${project.build.directory}/zora-bin/bin/status.sh</source>
            <outputDirectory>bin</outputDirectory>
            <fileMode>0755</fileMode>
        </file>
        <file>
            <source>${project.build.directory}/zora-bin/bin/deploy.sh</source>
            <outputDirectory>bin</outputDirectory>
            <fileMode>0755</fileMode>
        </file>
    </files>
    <fileSets>
        <fileSet>
            <directory>${project.basedir}</directory>
            <outputDirectory>/</outputDirectory>
            <includes><include>README.md</include></includes>
        </fileSet>
    </fileSets>
</assembly>

