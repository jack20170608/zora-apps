# Set issueKey manually to a confirmed test issue; createdIssueKey is not used automatically.
# Read editmeta before writing and verify the fields and operations are supported.

### Read the selected issue
# @name jiraReadIssue
# @no-redirect
# @no-log
GET {{jiraBaseUrl}}/rest/api/2/issue/{{issueKey}}?fields=summary,description,status,labels,issuetype,project
Authorization: {{$env.JIRA_AUTHORIZATION}}
Accept: application/json

> {%
    client.test("Issue is readable", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
        client.assert(response.body && response.body.key && response.body.fields, "Expected an issue resource");
    });
%}

### Inspect editable fields and supported operations
# @name jiraEditMetadata
# @no-redirect
# @no-log
GET {{jiraBaseUrl}}/rest/api/2/issue/{{issueKey}}/editmeta
Authorization: {{$env.JIRA_AUTHORIZATION}}
Accept: application/json

> {%
    client.test("Edit metadata is available", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
        client.assert(response.body && response.body.fields, "Expected editable field metadata");
    });
%}

### Replace only the test issue summary and description
# @name jiraSetIssueFields
# @no-redirect
# @no-log
< {%
    if (request.environment.get("allowWrites") !== true) {
        throw new Error("Write requests are disabled. Confirm the test issue and set allowWrites to boolean true.");
    }
%}
PUT {{jiraBaseUrl}}/rest/api/2/issue/{{issueKey}}
Authorization: {{$env.JIRA_AUTHORIZATION}}
Accept: application/json
Content-Type: application/json

{
  "fields": {
    "summary": "[API TEST] Updated through Jira REST API v2",
    "description": "Updated manually from the JetBrains HTTP Client. Only explicitly supplied fields are replaced."
  }
}

> {%
    client.test("Issue fields are updated", function () {
        client.assert(response.status === 204, "Expected HTTP 204 with no response body");
    });
%}

### Add a label without replacing the existing label collection
# @name jiraAddIssueLabel
# @no-redirect
# @no-log
< {%
    if (request.environment.get("allowWrites") !== true) {
        throw new Error("Write requests are disabled. Confirm the test issue and set allowWrites to boolean true.");
    }
%}
PUT {{jiraBaseUrl}}/rest/api/2/issue/{{issueKey}}
Authorization: {{$env.JIRA_AUTHORIZATION}}
Accept: application/json
Content-Type: application/json

{
  "update": {
    "labels": [
      {
        "add": "jira-api-test-updated"
      }
    ]
  }
}

> {%
    client.test("Issue label is added", function () {
        client.assert(response.status === 204, "Expected HTTP 204 with no response body");
    });
%}
